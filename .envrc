# direnv configuration. The Nix devShell only supports Linux (GRUB isn't
# packaged for macOS in nixpkgs), so it is only loaded there; on macOS, follow
# docs/building/macos.md instead.
#
# Put personal additions in .envrc.local (ignored by Git).

watch_file rust-toolchain.toml nix/flake.nix nix/flake.lock

if [[ "$(uname -s)" == Linux ]] && has nix; then
  use flake ./nix
fi

source_env_if_exists .envrc.local
